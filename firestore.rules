rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isTeacherAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'hadmed.brave@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprint (Anti-Update-Gap)
    function isValidTeacherSubject(data) {
      return data.keys().hasAll([
        'id',
        'titre',
        'oeuvre',
        'region',
        'annee',
        'session',
        'consigne',
        'typePlanSuggere',
        'sourceEnseignant',
        'isModifiedByTeacher',
        'isDeleted',
        'isPublic',
        'dateAjout',
        'dateModif',
        'createdByUid',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'titre',
        'oeuvre',
        'region',
        'annee',
        'session',
        'consigne',
        'typePlanSuggere',
        'conseilsEnseignant',
        'sourceEnseignant',
        'isModifiedByTeacher',
        'isDeleted',
        'isPublic',
        'dateAjout',
        'dateModif',
        'createdByUid',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.titre is string && data.titre.size() >= 1 && data.titre.size() <= 300 &&
      data.oeuvre is string && data.oeuvre.size() <= 100 && data.oeuvre in [
        'La Boîte à Merveilles',
        'Antigone',
        'Le Dernier Jour d\u2019un Condamné',
        'Le Dernier Jour d\'un Condamné',
        'Sujet de Société Général'
      ] &&
      data.region is string && data.region.size() >= 1 && data.region.size() <= 150 &&
      data.annee is string && data.annee.size() >= 1 && data.annee.size() <= 20 &&
      data.session is string && data.session.size() <= 50 && data.session in [
        'Session Normale',
        'Session de Rattrapage'
      ] &&
      data.consigne is string && data.consigne.size() >= 1 && data.consigne.size() <= 8000 &&
      data.typePlanSuggere is string && data.typePlanSuggere.size() <= 50 && data.typePlanSuggere in [
        'Plan Simple',
        'Plan Dialectique',
        'Plan Analytique'
      ] &&
      (!('conseilsEnseignant' in data) || (data.conseilsEnseignant is string && data.conseilsEnseignant.size() <= 2000)) &&
      data.sourceEnseignant is bool &&
      data.isModifiedByTeacher is bool &&
      data.isDeleted is bool &&
      data.isPublic is bool && data.isPublic == true &&
      data.dateAjout is string && data.dateAjout.size() >= 1 && data.dateAjout.size() <= 64 &&
      data.dateModif is string && data.dateModif.size() >= 1 && data.dateModif.size() <= 64 &&
      data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // 4. Collection: teacher_subjects (Public read for all students, verified teacher admin writes)
    match /teacher_subjects/{subjectId} {
      allow get: if isValidId(subjectId) && (existing().isPublic == true || isTeacherAdmin());
      allow list: if resource.data.isPublic == true;

      allow create: if isVerifiedUser()
        && isValidId(subjectId)
        && isValidTeacherSubject(incoming())
        && incoming().id == subjectId
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isTeacherAdmin();

      allow update: if isVerifiedUser()
        && isValidId(subjectId)
        && isValidTeacherSubject(incoming())
        && incoming().id == existing().id
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().dateAjout == existing().dateAjout
        && incoming().isPublic == existing().isPublic
        && incoming().updatedAt == request.time
        && (
          (isTeacherAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'titre',
            'oeuvre',
            'region',
            'annee',
            'session',
            'consigne',
            'typePlanSuggere',
            'conseilsEnseignant',
            'sourceEnseignant',
            'isModifiedByTeacher',
            'isDeleted',
            'dateModif',
            'updatedAt'
          ]))
        );

      allow delete: if isVerifiedUser()
        && isValidId(subjectId)
        && isTeacherAdmin();
    }

    // 5. Collection: admins (Read-only for self/admin, never writable from client SDK)
    match /admins/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (request.auth.uid == userId || isTeacherAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
